ARG TARGETARCH=amd64

FROM scratch AS longbridge-amd64
ADD --checksum=sha256:8f9f11fe79e3520ee0542e5f2f645b16632d76fedebbbda7e365d3a2c55e6c86 \
    https://github.com/longbridge/longbridge-terminal/releases/download/v0.28.4/longbridge-terminal-linux-musl-amd64.tar.gz \
    /longbridge.tar.gz

FROM scratch AS longbridge-arm64
ADD --checksum=sha256:e149ef28435e8d8196287b5fc1d79f663cd7186a4b583f42e831a5d82315019a \
    https://github.com/longbridge/longbridge-terminal/releases/download/v0.28.4/longbridge-terminal-linux-musl-arm64.tar.gz \
    /longbridge.tar.gz

FROM longbridge-${TARGETARCH} AS longbridge

FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

COPY --from=longbridge /longbridge.tar.gz /tmp/longbridge.tar.gz

RUN addgroup --system calendar \
    && adduser --system --ingroup calendar --home /home/calendar calendar \
    && install -d -o calendar -g calendar /home/calendar/.longbridge/openapi \
    && tar -xzf /tmp/longbridge.tar.gz -C /usr/local/bin \
    && chmod 0755 /usr/local/bin/longbridge \
    && rm /tmp/longbridge.tar.gz

WORKDIR /app
COPY apps/api/pyproject.toml ./
COPY apps/api/trade_calendar ./trade_calendar
COPY apps/api/alembic ./alembic
COPY apps/api/alembic.ini ./alembic.ini
COPY apps/worker ./worker
COPY config ./config
RUN --mount=type=cache,target=/root/.cache/pip pip install .

USER calendar
EXPOSE 8000
CMD ["uvicorn", "trade_calendar.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
