FROM python:3.12-slim AS runtime

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN addgroup --system calendar && adduser --system --ingroup calendar calendar

WORKDIR /app
COPY apps/api/pyproject.toml ./
COPY apps/api/trade_calendar ./trade_calendar
COPY apps/api/alembic ./alembic
COPY apps/api/alembic.ini ./alembic.ini
COPY apps/worker ./worker
COPY config ./config
RUN --mount=type=cache,target=/root/.cache/pip pip install .

USER calendar
EXPOSE 8000
CMD ["uvicorn", "trade_calendar.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
