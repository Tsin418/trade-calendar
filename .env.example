# Database
POSTGRES_DB=calendar
POSTGRES_USER=calendar
POSTGRES_PASSWORD=change-me
CALENDAR_DATABASE_URL=postgresql+asyncpg://calendar:change-me@db:5432/calendar

# Application
CALENDAR_ENVIRONMENT=development
CALENDAR_USER_TIMEZONE=Asia/Shanghai
CALENDAR_SESSION_SECRET=replace-with-at-least-32-random-characters
CALENDAR_ICS_TOKEN=replace-with-a-random-private-token
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional notifications
CALENDAR_FEISHU_WEBHOOK_URL=

# Production only
CALENDAR_DOMAIN=calendar.example.com
CALENDAR_ADMIN_PASSWORD_HASH=

